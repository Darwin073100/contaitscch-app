// CONTAITSCCH - SQLite local (v2: 6 niveles × 4 temas, ejercicio por tema y examen integrador)
// Fechas: TEXT ISO-8601 UTC | Booleanos: INTEGER 0/1 | PRAGMA foreign_keys = ON
// SQLite no tiene tipo UUID: se guarda como TEXT (36 caracteres).
// El esquema real está en src/core/database/schema/ (Drizzle) y sus migraciones en
// src/core/database/migrations/ (0002_cliente_v2 creó este modelo).
// El contenido (level, topic, quiz, question, question_option, glossary_term) se siembra desde los
// JSON de src/core/database/seed/content/ cuando sube manifest.version.
//
// COLUMNAS DE AUDITORÍA (en TODAS las tablas):
//   created_at : cuándo se creó la fila. En Drizzle el default real es
//                strftime('%Y-%m-%dT%H:%M:%fZ','now') (ISO-8601 UTC); aquí se abrevia CURRENT_TIMESTAMP.
//   updated_at : última modificación. SQLite NO lo actualiza solo: lo pone el repositorio con el Clock.
//   Las fechas de negocio (passed_at, fetched_at, last_synced_at) las pone la app con el Clock inyectado.

Project contaitscch_sqlite {
  database_type: 'SQLite'
}

// ====================== USUARIO ======================
Table user {
  id             text [pk, note: 'UUID del usuario: el MISMO que profile.id en Supabase.']
  first_name     text [not null, note: 'Nombre(s). Mínimo 3 caracteres.']
  last_name      text [not null, note: 'Apellidos. Mínimo 3 caracteres.']
  email          text [not null, unique, note: 'Correo electrónico (con @).']
  country        text [not null, note: 'País (requerido).']
  state          text [not null, note: 'Estado (requerido).']
  city           text [null, note: 'Ciudad (opcional).']
  email_verified integer [not null, default: 0, note: '1 = ya validó el código del correo y puede entrar.']
  created_at     text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at     text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Perfil del usuario con sesión en el teléfono. La contraseña NO se guarda (solo su hash, en Supabase).'
}

// ====================== CONTENIDO (solo lectura) ======================
Table content_meta {
  id         integer [pk, note: 'Siempre 1 (CHECK): una sola fila.']
  version    integer [not null, note: 'manifest.version ya sembrada; si el JSON trae una mayor, se vuelve a sembrar.']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]
}

Table level {
  id         integer [pk, note: 'Inmutable: 1..6.']
  sort_order integer [not null, unique, note: 'Orden del nivel; define cuál es el "anterior".']
  title      text [not null, note: '"Fundamentos: qué es la contabilidad y para qué sirve".']
  goal       text [not null, note: '"Al terminar este nivel el alumno…" (texto de la tarjeta).']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]
}

Table topic {
  id         integer [pk, note: 'Inmutable: nivel×100 + orden (203 = Nivel 2, tema 3).']
  level_id   integer [not null, ref: > level.id]
  sort_order integer [not null, note: '1..4 dentro del nivel.']
  title      text [not null]
  objective  text [not null, note: 'Paso 1 de la lección (junto a la infografía).']
  content    text [not null, note: 'JSON (LessonBody): explanation[], example{title, steps[]}, keyIdea, commonError, activity.']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (level_id, sort_order) [unique]
  }
}

Table quiz {
  id         integer [pk, note: 'Ejercicio de un tema (= id del tema) o examen integrador (900).']
  kind       text [not null, note: "'topic' | 'final'. CHECK: kind = 'topic' si y solo si topic_id no es NULL."]
  topic_id   integer [null, unique, ref: - topic.id]
  pass_mark  integer [not null, note: 'Aciertos mínimos para aprobar (tema: todas sus preguntas; examen: 8).']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]
}

Table question {
  id         integer [pk, note: 'Inmutable: quiz×100 + orden (20302, 90010). Solo opción múltiple.']
  quiz_id    integer [not null, ref: > quiz.id]
  sort_order integer [not null]
  statement  text [not null]
  feedback   text [null, note: 'Se muestra solo cuando el alumno acierta (el examen no tiene).']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (quiz_id, sort_order) [unique]
  }
}

Table question_option {
  id          integer [pk, note: 'Inmutable: pregunta×10 + posición (203024).']
  question_id integer [not null, ref: > question.id]
  sort_order  integer [not null, note: 'Posición 1..4 (letras A–D).']
  text        text [not null]
  is_correct  integer [not null, default: 0, note: 'Exactamente una por pregunta (lo valida el esquema Zod). Nunca sale a la UI.']
  created_at  text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at  text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (question_id, sort_order) [unique]
  }
}

Table glossary_term {
  term       text [pk, note: 'Término (llave natural). Se reemplaza completo al sembrar.']
  definition text [not null]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]
}

// ====================== AVANCE DEL USUARIO ======================
Table quiz_progress {
  user_id    text [not null, ref: > user.id]
  quiz_id    integer [not null, ref: > quiz.id]
  passed     integer [not null, default: 0, note: 'Aprobó al menos una vez. Nunca vuelve a 0 (salvo "Reiniciar mi avance").']
  best_score integer [not null, default: 0, note: 'Mejor número de aciertos.']
  attempts   integer [not null, default: 0, note: 'Intentos. Al fusionar con la nube se toma el mayor.']
  passed_at  text [null, note: 'Primera vez que aprobó. CHECK: requerido si passed = 1.']
  synced_at  text [null, note: 'Igual a updated_at cuando la nube ya tiene esta versión. Pendiente = NULL o distinto.']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`, note: 'Clock.nowIso() en cada cambio.']

  indexes {
    (user_id, quiz_id) [pk]
    user_id [name: 'quiz_progress_pending_idx', note: 'Parcial: WHERE synced_at IS NULL OR synced_at <> updated_at.']
  }

  Note: 'Única tabla de avance: temas aprobados, temas por aprobar, niveles completados y el examen se CALCULAN de aquí. También es la cola de lo que falta subir (Outbox).'
}

Table sync_state {
  user_id        text [pk, ref: - user.id]
  generation     integer [null, note: 'progress_generation de la nube; NULL = este teléfono nunca ha sincronizado.']
  last_synced_at text [null]
  last_error     text [null, note: "'offline' | 'network' | 'invalid_input' | 'invalid_token'; NULL si salió bien."]
  created_at     text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at     text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Lo que pinta el indicador de sincronización y la generación que se manda a sync_progress.'
}

Table leaderboard_cache {
  user_id    text [pk, ref: - user.id]
  payload    text [not null, note: 'Último ranking recibido (JSON).']
  fetched_at text [not null, note: 'Para "Ranking de hace X" sin red.']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]
}
